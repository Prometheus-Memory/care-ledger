# Copy the values you need into your shell. Nothing here is required: with no Bedrock model set,
# the demo runs on the built-in rule parser.
PORT=8787
# Brain (server side only; never sent to the browser)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-lite-v1:0
# CARE_BRAIN=rules            # force the rule parser even if a model is set
# Store: local JSON lines (default) or DynamoDB
# CARE_STORE=dynamo
# CARE_TABLE=care-ledger
# CARE_HOUSEHOLD=demo
# CARE_DATA=./data/ledger.jsonl
